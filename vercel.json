{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/tv/:path*", "destination": "/index.html" }
  ],
  "functions": {
    "api/tv/media/normalize-video.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/cron/cleanup-unused-media", "schedule": "0 3 * * *" }
  ]
}
